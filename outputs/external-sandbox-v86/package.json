{
  "name": "external-sandbox-v86",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local shell sandbox with v86 Linux, live directory mounts, streaming execution, and managed HTTP egress",
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "external-sandbox-v86": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "src/**/*.ts",
    "tsconfig.json",
    "scripts/prepare-image.mjs",
    "images/linux/image.json",
    "images/linux/bzimage",
    "images/linux/initrd.img",
    "images/linux/seabios.bin",
    "images/linux/vgabios.bin",
    "images/linux/packages.txt",
    "images/modules/*.ko.gz",
    "images/init",
    "images/build.mjs",
    "images/build-in-container.sh",
    "images/sources.lock.json",
    "images/README.md",
    "images/V86-LICENSE",
    "guest/agent/agent.c",
    "guest/agent/Makefile",
    "guest/agent/README.md",
    "guest/agent/PROTOCOL.md",
    "guest/agent/test.mjs",
    "docs/*.md",
    "examples/*.json",
    "PROVENANCE.md",
    "scripts/copy-ui-assets.mjs",
    "dist/ui/shared/assets/*",
    "dist/ui/shared/manifest.json",
    "dist/ui/shared/package.json",
    "src/ui/shared/**",
    "scripts/clean-dist.mjs"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-ui-assets.mjs",
    "start": "node dist/cli.js",
    "dev": "node --import tsx src/cli.ts",
    "check": "tsc --noEmit && npm run check:ui",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:proxy": "node --import tsx --test test/proxy-*.test.ts test/managed-proxy.test.ts test/wisp-relay.test.ts test/v86-network-guard.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "check:ui": "node scripts/copy-ui-assets.mjs --check"
  },
  "dependencies": {
    "node-forge": "1.4.0",
    "v86": "0.5.458",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/node-forge": "1.3.14",
    "@types/ws": "8.18.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
